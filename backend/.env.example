PORT=8080
DB_PATH=./data/afyamind.db
SESSION_TTL_HOURS=168
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider: openai, ollama, or fallback.
AI_PROVIDER=openai

# OpenAI settings. The backend uses the Responses API.
# gpt-5.4-mini is a sensible low-latency default for chat, but you can override it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# Ollama settings for local inference.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
